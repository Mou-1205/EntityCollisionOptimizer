# 项目排除路径
/.gradle/
/build/
/vanilla-gametest/.gradle/
/vanilla-gametest/build/
/dist/
/build/classes/java/main/
/run/
/.idea/
/native/*
!/native/CMakeLists.txt
!/native/version-script
!/native/src/
!/native/include/
!/native/README.md

# Generated diagnostics belong outside the source tree.
*.jfr
*.etl
*.etl.*
__pycache__/

# Local analysis artifacts and editor state.
/.vscode/
/bin/
/analysis_samples/
/mspt_analysis/
/extract_mspt_curves.py

# Local session memory (do not upload)
/LOCAL_SESSION_MEMORY.md

# Local in-game diagnostics (do not upload)
/eco-ingame-check*.png
/tools/*.py

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
